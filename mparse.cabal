cabal-version:   3.0
name:            mparse
version:         0.1.1.0
license:         MIT
license-file:    LICENSE
author:          Michael Miller
maintainer:      mikeaamiller117@gmail.com
category:        Development
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        Mparse.DotEnv
        Mparse.Format
        Mparse.Parser
        Mparse.EParser

    build-depends:
        , base        ^>=4.20.0.0
        , containers

    hs-source-dirs:   src
    default-language: Haskell2010

test-suite parser
    import:             warnings
    default-language:   Haskell2010
    other-modules:
        TestSpec
        Characters
        Combinators
        Optionals
        Primitives
        Spaces

    type:               exitcode-stdio-1.0
    hs-source-dirs:     test/parser
    main-is:            Spec.hs
    build-depends:
        , base            ^>=4.20.0.0
        , hspec
        , hspec-discover
        , mparse
        , raw-strings-qq

    ghc-options:        -O -threaded -rtsopts -with-rtsopts=-N
    build-tool-depends: hspec-discover:hspec-discover


test-suite samples
    import:             warnings
    default-language:   Haskell2010
    other-modules:
        Custom1Spec

    type:               exitcode-stdio-1.0
    hs-source-dirs:     test/samples/custom1
    main-is:            Spec.hs
    build-depends:
        , base            ^>=4.20.0.0
        , hspec
        , hspec-discover
        , mparse
        , raw-strings-qq

    ghc-options:        -O -threaded -rtsopts -with-rtsopts=-N
    build-tool-depends: hspec-discover:hspec-discover

test-suite parser-v1
    import:             warnings
    default-language:   Haskell2010
    other-modules:
        Tests
        DotEnv.Tests
        DotEnv.DotEnvSpec
        Format.Tests
        Format.FormatSpec
        Parser.Tests
        Parser.ParserSpec

    type:               exitcode-stdio-1.0
    hs-source-dirs:     test/V1
    main-is:            Spec.hs
    build-depends:
        , base            ^>=4.20.0.0
        , hspec
        , hspec-discover
        , mparse
        , raw-strings-qq

    ghc-options:        -O -threaded -rtsopts -with-rtsopts=-N
    build-tool-depends: hspec-discover:hspec-discover
